<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/ui_dialog_background"
    android:paddingStart="22dp" android:paddingEnd="22dp"
    android:paddingTop="22dp" android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/ui_purple" xmlns:app="http://schemas.android.com/apk/res-auto"
            android:contentDescription="@null"/>

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="棋局设置"
            android:textColor="@color/ui_ink"
            android:textSize="19sp" android:textStyle="bold"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="16dp" android:background="@color/ui_line"/>

    <!-- 先手方 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:layout_marginEnd="12dp"
            android:text="先手方："
            android:textColor="@color/ui_ink" android:textSize="16sp"/>

        <TextView android:id="@+id/tvRedFirst"
            android:layout_width="130dp" android:layout_height="44dp"
            android:layout_marginEnd="30dp"
            android:background="@drawable/bg_toggle_option"
            android:gravity="center"
            android:text="红方"
            android:textColor="@color/ui_red" android:textSize="16sp"/>
    </LinearLayout>

    <!-- 红方 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:layout_marginEnd="12dp"
            android:text="红方："
            android:textColor="@color/ui_ink" android:textSize="16sp"/>

        <TextView android:id="@+id/tvRedSide"
            android:layout_width="130dp" android:layout_height="44dp"
            android:layout_marginEnd="30dp"
            android:background="@drawable/bg_toggle_option"
            android:gravity="center"
            android:text="棋手"
            android:textColor="@color/ui_ink" android:textSize="16sp"/>
    </LinearLayout>

    <!-- 黑方 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:layout_marginEnd="12dp"
            android:text="黑方："
            android:textColor="@color/ui_ink" android:textSize="16sp"/>

        <TextView android:id="@+id/tvBlackSide"
            android:layout_width="130dp" android:layout_height="44dp"
            android:layout_marginEnd="30dp"
            android:background="@drawable/bg_toggle_option"
            android:gravity="center"
            android:text="棋手"
            android:textColor="@color/ui_ink" android:textSize="16sp"/>
    </LinearLayout>

    <!-- 取消 / 确定 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="26dp">

        <TextView android:id="@+id/btnCancel"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_cancel"
            android:gravity="center"
            android:text="取消"
            android:textColor="@color/ui_purple" android:textSize="17sp"/>

        <Space
            android:layout_width="14dp" android:layout_height="1dp"/>

        <TextView android:id="@+id/btnConfirm"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_confirm"
            android:gravity="center"
            android:text="确定"
            android:textColor="#FFFFFF" android:textSize="17sp"/>
    </LinearLayout>
</LinearLayout>
