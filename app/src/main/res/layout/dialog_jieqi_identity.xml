<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/ui_dialog_background"
    android:padding="22dp">

    <TextView android:id="@+id/jqIdTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="请选择揭晓身份"
        android:textColor="@color/ui_ink" android:textSize="18sp" android:textStyle="bold"/>

    <TextView android:id="@+id/jqIdDesc"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="对照原棋盘翻出的棋子选择"
        android:textColor="@color/ui_muted" android:textSize="13sp"/>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="18dp">
        <TextView android:id="@+id/jqIdR" style="@style/JqIdBtn" android:text="车"/>
        <TextView android:id="@+id/jqIdN" style="@style/JqIdBtn" android:text="马"/>
        <TextView android:id="@+id/jqIdB" style="@style/JqIdBtn" android:text="相"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <TextView android:id="@+id/jqIdA" style="@style/JqIdBtn" android:text="仕"/>
        <TextView android:id="@+id/jqIdC" style="@style/JqIdBtn" android:text="炮"/>
        <TextView android:id="@+id/jqIdP" style="@style/JqIdBtn" android:text="兵"/>
    </LinearLayout>

    <TextView android:id="@+id/jqIdMinimize"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:gravity="center"
        android:paddingVertical="8dp"
        android:text="最小化（稍后再录，棋盘高亮暗子）"
        android:textColor="@color/ui_muted" android:textSize="13sp"/>
</LinearLayout>
