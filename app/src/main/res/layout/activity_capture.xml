<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <!-- 3:4 取景框：仅上下两条横线（与基准相机页一致） -->
    <View
        android:layout_width="match_parent" android:layout_height="2dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="660dp"
        android:background="#FFFFFFFF" />
    <View
        android:layout_width="match_parent" android:layout_height="2dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="1860dp"
        android:background="#FFFFFFFF" />

    <TextView
        android:id="@+id/capHint"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="300dp"
        android:text="@string/cap_hint" android:textColor="#FFFFFF" android:textSize="20sp" />

    <!-- 紫色胶囊大按钮：位置/尺寸/颜色与基准一致，仅文案改为「拍照识别」 -->
    <Button android:id="@+id/btnShot"
        android:layout_width="320dp" android:layout_height="64dp"
        android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="150dp"
        android:background="@drawable/bg_capture_btn"
        android:text="@string/cap_shot" android:textColor="#FFFFFF" android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 新增：右下角靠近侧边栏的相册入口（图标 + 文字） -->
    <LinearLayout
        android:id="@+id/btnAlbum"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:layout_marginEnd="48dp"
        android:layout_marginBottom="140dp"
        android:orientation="vertical" android:gravity="center"
        android:clickable="true" android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless">
        <ImageView
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_album" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="相册" android:textColor="#FFFFFF" android:textSize="14sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</FrameLayout>
