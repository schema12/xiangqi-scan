<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <!-- 3:4 取景框：上下两条白色横线，垂直居中（上留白=下留白≈604px） -->
    <View
        android:layout_width="match_parent" android:layout_height="2dp"
        android:layout_gravity="top" android:layout_marginTop="165dp"
        android:background="#FFFFFFFF" />
    <View
        android:layout_width="match_parent" android:layout_height="2dp"
        android:layout_gravity="top" android:layout_marginTop="565dp"
        android:background="#FFFFFFFF" />

    <!-- 提示文字（下横线之下、按钮之上） -->
    <TextView
        android:id="@+id/capHint"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="170dp"
        android:text="@string/cap_hint" android:textColor="#FFFFFF" android:textSize="20sp" />

    <!-- 紫色胶囊按钮：中心线与相册图标对齐 -->
    <Button android:id="@+id/btnShot"
        android:layout_width="160dp" android:layout_height="44dp"
        android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="34dp"
        android:background="@drawable/bg_capture_btn"
        android:text="@string/cap_shot" android:textColor="#FFFFFF" android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 相册入口：仅图标，中心线与按钮对齐 -->
    <ImageView
        android:id="@+id/btnAlbum"
        android:layout_width="40dp" android:layout_height="40dp"
        android:layout_gravity="bottom|end" android:layout_marginEnd="27dp"
        android:layout_marginBottom="36dp"
        android:src="@drawable/ic_album"
        android:clickable="true" android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="相册" />
</FrameLayout>
