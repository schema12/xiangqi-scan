<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <com.zfdang.chess.views.BoardEditView
            android:id="@+id/boardEdit"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- FEN / 置信度紧贴棋盘下方，三个按钮纵向排列、水平居中 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:background="#F2EFE9"
            android:paddingHorizontal="16dp" android:paddingTop="10dp" android:paddingBottom="16dp">

            <TextView android:id="@+id/tvFen"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#1A1A1A" android:textSize="13sp"
                android:fontFamily="monospace" android:maxLines="2" android:gravity="center"
                android:text="—" />

            <TextView android:id="@+id/tvConf"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#666666" android:textSize="13sp" android:text=""
                android:layout_marginTop="2dp" />

            <Button android:id="@+id/btnFlip"
                android:layout_width="220dp" android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:textSize="15sp" android:singleLine="true"
                android:text="@string/rec_flip" />

            <Button android:id="@+id/btnCopyFen"
                android:layout_width="220dp" android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="15sp" android:singleLine="true"
                android:text="@string/rec_copy_fen" />

            <Button android:id="@+id/btnStartGame"
                android:layout_width="220dp" android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="15sp" android:singleLine="true"
                android:text="@string/rec_start_game" />
        </LinearLayout>
    </LinearLayout>

    <!-- 识别中遮罩 -->
    <FrameLayout android:id="@+id/loadingOverlay"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#CC222222" android:visibility="gone"
        android:clickable="true" android:focusable="true">
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:layout_gravity="center">
            <ProgressBar
                android:layout_width="56dp" android:layout_height="56dp" />
            <TextView android:id="@+id/tvLoading"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="#FFFFFF" android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
