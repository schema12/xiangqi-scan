<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="16dp">
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/boolean_strategy_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="启用激进策略(关闭 = 完全原版对弈)"
            android:textSize="14sp"
            android:textColor="@color/ui_ink"
            app:useMaterialThemeColors="false"
                app:thumbTint="@color/ui_switch_thumb"
                app:trackTint="@color/ui_switch_track" />
        <TextView
            android:id="@+id/textview_risk_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="总开关关闭时,以下设置保留但不生效"
            android:textSize="12sp"
            android:textColor="@color/ui_muted"
            android:paddingStart="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="风险等级"
                android:textSize="14sp"
                android:textColor="@color/ui_ink" />
            <TextView
                android:id="@+id/textview_risk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 · 稳健"
                android:textSize="14sp"
                android:textColor="@color/ui_red"
                android:textStyle="bold" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/seekbar_risk"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:min="0"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/ui_red"
            android:thumbTint="@color/ui_red" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/boolean_strength_guard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="棋力保护 · 限制评估损失(推荐开启)"
            android:textSize="14sp"
            android:textColor="@color/ui_ink"
            app:useMaterialThemeColors="false"
                app:thumbTint="@color/ui_switch_thumb"
                app:trackTint="@color/ui_switch_track" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="功能开关"
            android:textSize="13sp"
            android:textColor="@color/ui_ink"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/boolean_candidate_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="额外候选搜索(逐着受限复验)"
            android:textSize="14sp"
            android:textColor="@color/ui_ink"
            app:useMaterialThemeColors="false"
                app:thumbTint="@color/ui_switch_thumb"
                app:trackTint="@color/ui_switch_track" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/boolean_wdl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="WDL 评估(胜/和/负概率)"
            android:textSize="14sp"
            android:textColor="@color/ui_ink"
            app:useMaterialThemeColors="false"
                app:thumbTint="@color/ui_switch_thumb"
                app:trackTint="@color/ui_switch_track" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/boolean_attack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="攻击特征评分"
            android:textSize="14sp"
            android:textColor="@color/ui_ink"
            app:useMaterialThemeColors="false"
                app:thumbTint="@color/ui_switch_thumb"
                app:trackTint="@color/ui_switch_track" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/boolean_sacrifice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="弃子补偿分析"
            android:textSize="14sp"
            android:textColor="@color/ui_ink"
            app:useMaterialThemeColors="false"
                app:thumbTint="@color/ui_switch_thumb"
                app:trackTint="@color/ui_switch_track" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/boolean_aggressive_book"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="激进专用开局库(Risk>0 时启用)"
            android:textSize="14sp"
            android:textColor="@color/ui_ink"
            app:useMaterialThemeColors="false"
                app:thumbTint="@color/ui_switch_thumb"
                app:trackTint="@color/ui_switch_track" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/boolean_opening_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="开局风格偏好"
            android:textSize="14sp"
            android:textColor="@color/ui_ink"
            app:useMaterialThemeColors="false"
                app:thumbTint="@color/ui_switch_thumb"
                app:trackTint="@color/ui_switch_track" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/boolean_diversity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="多样性评分(仅近并列候选生效)"
            android:textSize="14sp"
            android:textColor="@color/ui_ink"
            app:useMaterialThemeColors="false"
                app:thumbTint="@color/ui_switch_thumb"
                app:trackTint="@color/ui_switch_track" />
        <TextView
            android:id="@+id/textview_detail_entry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:text="策略详细设置(α/β/γ 维度覆盖)  ›"
            android:textSize="14sp"
            android:textColor="@color/ui_ink"
            android:layout_marginTop="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="安全机制(合法着法校验、评估退化上限、杀棋保护、超时与回退、单次提交)始终生效,不可关闭。"
            android:textSize="12sp"
            android:textColor="@color/ui_muted"
            android:paddingStart="4dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
