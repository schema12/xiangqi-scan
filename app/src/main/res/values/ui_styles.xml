<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.ChineseChess.Refreshed" parent="Theme.Material3.Light.NoActionBar">
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Chess.Dialog</item>
        <item name="colorPrimary">@color/ui_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/ui_surface</item>
        <item name="colorOnSurface">@color/ui_ink</item>
        <item name="colorControlNormal">@color/ui_ink</item>
        <item name="android:colorBackground">@color/ui_paper</item>
        <item name="android:statusBarColor">@color/ui_paper</item>
        <item name="android:navigationBarColor">@color/ui_ink</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="Theme.ChineseChess.Refreshed" parent="Base.Theme.ChineseChess.Refreshed" />
    <style name="Widget.Chess.Action" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="ThemeOverlay.Chess.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/ui_red</item>
        <item name="colorSecondary">@color/ui_red</item>
        <item name="colorControlActivated">@color/ui_red</item>
        <item name="colorSurface">@color/ui_surface</item>
        <item name="colorOnSurface">@color/ui_ink</item>
        <item name="colorOnSurfaceVariant">@color/ui_muted</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Chess.Dialog</item>
    </style>
    <style name="ShapeAppearance.Chess.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
<style name="JqTool">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_weight">1</item>
    <item name="android:orientation">vertical</item>
    <item name="android:gravity">center</item>
    <item name="android:background">?attr/selectableItemBackground</item>
</style>
<style name="JqToolIcon">
    <item name="android:layout_width">24dp</item>
    <item name="android:layout_height">24dp</item>
    <item name="android:tint">@color/ui_ink</item>
</style>
<style name="JqToolLabel">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">6dp</item>
    <item name="android:textSize">12sp</item>
    <item name="android:textColor">@color/ui_ink</item>
</style>
<style name="JqIdBtn">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">48dp</item>
    <item name="android:layout_weight">1</item>
    <item name="android:layout_marginEnd">10dp</item>
    <item name="android:background">@drawable/bg_toggle_option</item>
    <item name="android:gravity">center</item>
    <item name="android:textColor">@color/ui_purple</item>
    <item name="android:textSize">17sp</item>
    <item name="android:textStyle">bold</item>
</style>
</resources>
