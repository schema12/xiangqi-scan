<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <View
        android:layout_width="300dp" android:layout_height="360dp"
        android:layout_gravity="center"
        android:background="#44000000" />

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="24dp"
        android:text="@string/cap_title" android:textColor="#FFFFFF" />

    <Button android:id="@+id/btnShot"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="64dp"
        android:text="@string/cap_shot" />
</FrameLayout>
